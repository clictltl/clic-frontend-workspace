*.tsbuildinfo

# ==========================================
# Arquivos de Ambiente e Segurança
# ==========================================
.env
.env.*
*.local
# Permite commitar um arquivo de exemplo se você criar um
!.env.example

# ==========================================
# Editores e Sistema Operacional
# ==========================================
# Lixo gerado pelo macOS
.DS_Store
# Configurações do WebStorm/IntelliJ, se alguém usar
.idea
# Ignora configs pessoais do VSCode...
.vscode/*
# ...mas permite commitar as extensões recomendadas da equipe
!.vscode/extensions.json

